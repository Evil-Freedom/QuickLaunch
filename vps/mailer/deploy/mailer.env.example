# /etc/qlmail/mailer.env  —— 由 systemd 以 root 读取后再降权到 qlmail
# 权限：chown root:root && chmod 600
# 本文件含上报令牌，绝不进 Git。

QLMAIL_DB=/var/lib/qlmail/notifications.db
QLMAIL_CLI=/usr/local/bin/agently-cli
QLMAIL_CONFIG_DIR=/var/lib/qlmail/config
QLMAIL_HOME=/var/lib/qlmail
QLMAIL_LOG=/var/log/qlmail/mailer.log

# 固定收件人（白名单）：主 → 备，绝不并行
QLMAIL_PRIMARY=<PRIMARY_RECIPIENT>
QLMAIL_FALLBACK=<FALLBACK_RECIPIENT>

# 监听地址：auto = 自动取 quicklaunch 的 docker 网桥网关（只有宿主机与容器能访问）
QLMAIL_BIND=auto
QLMAIL_PORT=8780

# 只允许这台设备上报
QLMAIL_DEVICES=dev_7cca07466cc0bbbb

# 成功通知开关：each=逐条发，off=不发（失败/告警始终发）
QLMAIL_SUCCESS_MODE=each

# 配额（与 agently-cli +me 返回值一致）
QLMAIL_DAILY_QUOTA=50
QLMAIL_HOURLY_LIMIT=200
QLMAIL_MINUTE_LIMIT=10

QLMAIL_SEND_TIMEOUT=45

# 生成方式：openssl rand -hex 32    （部署脚本会写好，不要手抄到聊天里）
QLMAIL_INGEST_TOKEN=

# ── 统一考勤数据源（2026-11-25）─────────────────────────────────
# 考勤证据只向运营部看板要，不再自己查飞书：
# 两个数据源同时存在会出现「看板说已打卡、手机还在等」。
# QL_BOARD_TOKEN 必须与 VPS 上 /etc/team-desk-board/board.env 的
# QL_INTERNAL_TOKEN 完全一致（openssl rand -hex 32 生成一次，两边填同一个）。
QL_BOARD_URL=http://127.0.0.1:8900
QL_BOARD_TOKEN=<与 board.env 的 QL_INTERNAL_TOKEN 相同>
QL_BOARD_TIMEOUT=8
# 看板不可达时是否回退到「自己查飞书」。默认关：回退会让两个服务给出两种结论。
QL_BOARD_FALLBACK_LARK=0
