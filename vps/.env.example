# 复制为 .env 后逐项填写：cp .env.example .env
#
# ⚠️ .env 里有口令摘要与会话密钥，**不要提交到版本库**。
# 本目录的 .gitignore 已包含 .env 与 data/。

# 你的域名（A 记录必须指向这台 VPS 的公网 IP）
QL_DOMAIN=ql.example.com

# 管理员口令的 SHA-256（推荐）。
# 生成方法（在服务器上执行，把 your-password 换成你的口令）：
#   printf '%s' 'your-password' | sha256sum | cut -d' ' -f1
# 用摘要而不是明文的好处：.env 泄露不等于口令泄露。
QL_ADMIN_PASSWORD_SHA256=

# 如果想图省事，也可以直接写明文（二选一，摘要优先级更高）
# QL_ADMIN_PASSWORD=

# 会话 cookie 的签名密钥，随便一串 64 位十六进制即可：
#   openssl rand -hex 32
QL_SESSION_SECRET=

# SQLite 路径（容器内），一般不用改
QL_DB_PATH=/data/quicklaunch.db
