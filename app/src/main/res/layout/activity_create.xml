<?xml version="1.0" encoding="utf-8"?>
<!--
  iOS 26 Liquid Glass 创建自动化界面
  - 毛玻璃输入框
  - 分组卡片
  - iOS 按钮样式
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ios26_wallpaper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/ios_space_lg">

        <!-- 名称输入卡片 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.QuickLaunch.Group.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/ios_glass_group_light">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="名称（可选）"
                android:padding="@dimen/ios_space_md"
                app:boxBackgroundMode="none"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="0dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:inputType="text"
                    android:textAppearance="@style/TextAppearance.QuickLaunch.Body" />
            </com.google.android.material.textfield.TextInputLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 应用选择按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickApp"
            style="@style/Widget.QuickLaunch.Button.Pill"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ios_button_height"
            android:layout_marginTop="@dimen/ios_space_md"
            android:text="选择要启动的应用" />

        <!-- 触发条件分组卡片 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.QuickLaunch.Group.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ios_space_md"
            app:cardBackgroundColor="@color/ios_glass_group_light">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/ios_space_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="触发条件"
                    android:textAppearance="@style/TextAppearance.QuickLaunch.Group.Header" />

                <Spinner
                    android:id="@+id/spinnerTrigger"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ios_space_sm"
                    android:entries="@array/trigger_types" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 时间设置分组卡片 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.QuickLaunch.Group.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ios_space_md"
            app:cardBackgroundColor="@color/ios_glass_group_light">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/ios_space_md">

                <LinearLayout
                    android:id="@+id/layoutTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnTime"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/ios_button_height"
                        android:text="08:00" />

                    <Spinner
                        android:id="@+id/spinnerRepeat"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ios_space_sm"
                        android:layout_weight="1"
                        android:entries="@array/repeat_modes" />
                </LinearLayout>

                <!-- 自定义星期多选 -->
                <LinearLayout
                    android:id="@+id/layoutCustomDays"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ios_space_md"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="选择星期（可多选）"
                        android:textAppearance="@style/TextAppearance.QuickLaunch.Caption" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ios_space_sm"
                        android:orientation="horizontal">

                        <ToggleButton
                            android:id="@+id/tbDay0"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minWidth="0dp"
                            android:textSize="@dimen/ios_text_caption"
                            android:textOff="日"
                            android:textOn="日" />

                        <ToggleButton
                            android:id="@+id/tbDay1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minWidth="0dp"
                            android:textSize="@dimen/ios_text_caption"
                            android:textOff="一"
                            android:textOn="一" />

                        <ToggleButton
                            android:id="@+id/tbDay2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minWidth="0dp"
                            android:textSize="@dimen/ios_text_caption"
                            android:textOff="二"
                            android:textOn="二" />

                        <ToggleButton
                            android:id="@+id/tbDay3"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minWidth="0dp"
                            android:textSize="@dimen/ios_text_caption"
                            android:textOff="三"
                            android:textOn="三" />

                        <ToggleButton
                            android:id="@+id/tbDay4"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minWidth="0dp"
                            android:textSize="@dimen/ios_text_caption"
                            android:textOff="四"
                            android:textOn="四" />

                        <ToggleButton
                            android:id="@+id/tbDay5"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minWidth="0dp"
                            android:textSize="@dimen/ios_text_caption"
                            android:textOff="五"
                            android:textOn="五" />

                        <ToggleButton
                            android:id="@+id/tbDay6"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minWidth="0dp"
                            android:textSize="@dimen/ios_text_caption"
                            android:textOff="六"
                            android:textOn="六" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 选项分组卡片 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.QuickLaunch.Group.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ios_space_md"
            app:cardBackgroundColor="@color/ios_glass_group_light">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/ios_space_md">

                <CheckBox
                    android:id="@+id/cbSkipHolidays"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="跳过中国法定节假日（含调休休息日）不触发"
                    android:textAppearance="@style/TextAppearance.QuickLaunch.Body" />

                <CheckBox
                    android:id="@+id/cbRandom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ios_space_sm"
                    android:text="随机时间（在窗口内，避免每天固定打卡）"
                    android:textAppearance="@style/TextAppearance.QuickLaunch.Body" />

                <LinearLayout
                    android:id="@+id/layoutRandom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ios_space_sm"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <Button
                        android:id="@+id/btnWinStart"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/ios_button_height"
                        android:layout_weight="1"
                        android:text="08:30" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text=" 至 " />

                    <Button
                        android:id="@+id/btnWinEnd"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/ios_button_height"
                        android:layout_weight="1"
                        android:text="08:50" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 蓝牙设备名 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/layoutBt"
            style="@style/Widget.QuickLaunch.Group.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ios_space_md"
            android:visibility="gone"
            app:cardBackgroundColor="@color/ios_glass_group_light">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="蓝牙设备名（可选，留空表示任意设备）"
                android:padding="@dimen/ios_space_md"
                app:boxBackgroundMode="none"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="0dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etBtName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:inputType="text"
                    android:textAppearance="@style/TextAppearance.QuickLaunch.Body" />
            </com.google.android.material.textfield.TextInputLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 保存按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            style="@style/Widget.QuickLaunch.Button.Pill"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ios_button_height"
            android:layout_marginTop="@dimen/ios_space_xl"
            android:text="保存" />

    </LinearLayout>
</ScrollView>
