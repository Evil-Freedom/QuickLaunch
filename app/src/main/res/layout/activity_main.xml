<?xml version="1.0" encoding="utf-8"?>
<!--
  iOS 26 Liquid Glass 主界面（保留原有业务逻辑）
  - 顶部毛玻璃操作卡片：防息屏开关 + 数据源选择 + 同步按钮 + 管理按钮
  - 中部弹性回滚列表：自动化规则
  - 悬浮 FAB 按钮
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ios26_wallpaper">

    <!-- 标题栏：iOS 毛玻璃悬浮卡片 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTitle"
        style="@style/Widget.QuickLaunch.Glass.Card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ios_space_lg"
        android:layout_marginTop="@dimen/ios_space_3xl"
        android:layout_marginEnd="@dimen/ios_space_lg"
        app:cardBackgroundColor="@color/ios_glass_search_light"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/ios_space_lg"
            android:paddingTop="@dimen/ios_space_lg"
            android:paddingEnd="@dimen/ios_space_lg"
            android:paddingBottom="@dimen/ios_space_md"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.QuickLaunch.Title"
            android:textStyle="bold" />
    </com.google.android.material.card.MaterialCardView>

    <!-- 操作区：iOS 分组卡片 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardOperations"
        style="@style/Widget.QuickLaunch.Group.Card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ios_space_lg"
        android:layout_marginTop="@dimen/ios_space_md"
        android:layout_marginEnd="@dimen/ios_space_lg"
        app:cardBackgroundColor="@color/ios_glass_group_light"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardTitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/ios_space_sm">

            <!-- 防外屏息屏开关行 -->
            <LinearLayout
                android:id="@+id/layoutAntiSleep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ios_space_lg"
                android:paddingEnd="@dimen/ios_space_lg"
                android:paddingTop="@dimen/ios_space_md"
                android:paddingBottom="@dimen/ios_space_md">

                <TextView
                    android:id="@+id/tvAntiSleep"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="防外屏息屏"
                    android:textAppearance="@style/TextAppearance.QuickLaunch.Body" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swAntiSleep"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:enabled="false" />
            </LinearLayout>

            <!-- iOS 风格分割线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/ios_border_hairline"
                android:layout_marginStart="@dimen/ios_space_lg"
                android:background="@color/ios_glass_border" />

            <!-- 数据源选择行 -->
            <LinearLayout
                android:id="@+id/layoutSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ios_space_lg"
                android:paddingEnd="@dimen/ios_space_lg"
                android:paddingTop="@dimen/ios_space_md"
                android:paddingBottom="@dimen/ios_space_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="数据源"
                    android:textAppearance="@style/TextAppearance.QuickLaunch.Body" />

                <Spinner
                    android:id="@+id/spinnerSource"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ios_space_sm"
                    android:layout_weight="1" />
            </LinearLayout>

            <!-- 同步节假日按钮 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSyncHolidays"
                style="@style/Widget.QuickLaunch.Button.Pill"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ios_button_height"
                android:layout_marginStart="@dimen/ios_space_lg"
                android:layout_marginTop="@dimen/ios_space_sm"
                android:layout_marginEnd="@dimen/ios_space_lg"
                android:text="同步法定节假日" />

            <!-- 管理按钮组 -->
            <LinearLayout
                android:id="@+id/layoutHolidayActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ios_space_lg"
                android:paddingEnd="@dimen/ios_space_lg"
                android:paddingTop="@dimen/ios_space_sm"
                android:paddingBottom="@dimen/ios_space_lg">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnManageHolidays"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/ios_button_height"
                    android:layout_marginEnd="@dimen/ios_space_sm"
                    android:layout_weight="1"
                    android:text="手动管理节假日" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnManageSources"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/ios_button_height"
                    android:layout_marginStart="@dimen/ios_space_sm"
                    android:layout_weight="1"
                    android:text="管理数据源" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 空状态 -->
    <LinearLayout
        android:id="@+id/tvEmpty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardOperations"
        app:layout_constraintVertical_bias="0.5">

        <ImageView
            android:id="@+id/ivEmptyIcon"
            android:layout_width="@dimen/ios_icon_xl"
            android:layout_height="@dimen/ios_icon_xl"
            android:contentDescription="@null"
            android:src="@drawable/ic_empty_state"
            app:tint="@color/ios_text_tertiary" />

        <TextView
            android:id="@+id/tvEmptyText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ios_space_md"
            android:text="还没有自动化规则"
            android:textAppearance="@style/TextAppearance.QuickLaunch.Caption" />
    </LinearLayout>

    <!-- 列表：去除原生 OverScroll，改用 iOS 弹性 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/ios_space_md"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="@dimen/ios_space_sm"
        android:paddingEnd="@dimen/ios_space_sm"
        android:paddingBottom="@dimen/ios_space_3xl"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardOperations" />

    <!-- iOS 风格悬浮操作按钮 -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAdd"
        android:layout_width="@dimen/ios_fab_size"
        android:layout_height="@dimen/ios_fab_size"
        android:layout_margin="@dimen/ios_space_xl"
        android:contentDescription="新建"
        android:src="@drawable/ic_add_ios"
        app:backgroundTint="@color/ios_blue"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/white" />

</androidx.constraintlayout.widget.ConstraintLayout>
