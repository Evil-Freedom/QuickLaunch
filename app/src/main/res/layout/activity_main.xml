<?xml version="1.0" encoding="utf-8"?>
<!--
  控制中心主框架（Edge-to-Edge 沉浸式 + 纯平漂浮药丸底栏）

  - 顶部无 Tab：标题与内容顶到状态栏下方
  - 主体：ViewPager2 左右滑动，复用 view_launch / view_sync
  - 底部：纯平无遮罩，两个独立漂浮胶囊药丸
      [ ic_home  快捷启动 ]  [ ic_source  节假日与数据源 ]
      选中 = 白磨砂 + 细白边框；未选中 = 普通暗卡片
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ═══ 主体：ViewPager2（页面由 MainActivity 注入，复用原 view_launch / view_sync） ═══ -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ═══ 底部暗黑渐变遮罩：淡化滚动到底部的内容，避免文字穿透悬浮胶囊 ═══ -->
    <View
        android:id="@+id/bottomGradientShadow"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:background="@drawable/bg_bottom_gradient"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- ═══ 底部：纯平无遮罩漂浮药丸 ═══ -->
    <LinearLayout
        android:id="@+id/floatingBottomBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:background="@android:color/transparent"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- 快捷启动 -->
        <LinearLayout
            android:id="@+id/bottomNavLaunch"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_item_active"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <ImageView
                android:id="@+id/ivNavLaunch"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="快捷启动"
                android:src="@drawable/ic_tab_launch"
                app:tint="@color/item_active_text" />

            <TextView
                android:id="@+id/tvNavLaunch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif"
                android:text="快捷启动"
                android:textColor="@color/item_active_text"
                android:textFontWeight="500"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- 节假日与数据源 -->
        <LinearLayout
            android:id="@+id/bottomNavSync"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/bg_item_inactive"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <ImageView
                android:id="@+id/ivNavSync"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="节假日与数据源"
                android:src="@drawable/ic_tab_sync"
                app:tint="@color/item_inactive_text" />

            <TextView
                android:id="@+id/tvNavSync"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif"
                android:text="节假日与数据源"
                android:textColor="@color/item_inactive_text"
                android:textSize="14sp" />

        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
