<?xml version="1.0" encoding="utf-8"?>
<!--
  控制中心主框架（Edge-to-Edge 沉浸式）

  - 顶部 Header：极简 Segment 分段控件
      [ 快捷启动 ] [ 节假日与数据源 ]
      选中态 = 强调绿实心胶囊，未选中 = 透出 widget 灰轨道
  - 主体：ViewPager2，左右滑动与 Segment 双向联动
  - 已彻底移除底部 BottomNavigationView（蓝色圆圈 + 笨重毛玻璃底坞），
    连带干掉底部硬边割裂感；底部留白改由 WindowInsets 动态施加。
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_root">

    <!-- ═══ 顶部 Header：Segment 分段控件 ═══ -->
    <LinearLayout
        android:id="@+id/segmentTrack"
        android:layout_width="0dp"
        android:layout_height="@dimen/dark_segment_height"
        android:layout_marginHorizontal="@dimen/dark_card_margin_horizontal"
        android:layout_marginTop="@dimen/dark_header_padding_vertical"
        android:layout_marginBottom="@dimen/dark_header_padding_vertical"
        android:background="@drawable/bg_segment_track"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="@dimen/dark_segment_inset"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/segLaunch"
            style="@style/Widget.QuickLaunch.Dark.Segment.Selected"
            android:text="快捷启动" />

        <TextView
            android:id="@+id/segSync"
            style="@style/Widget.QuickLaunch.Dark.Segment"
            android:text="节假日与数据源" />
    </LinearLayout>

    <!-- ═══ 主体：ViewPager2（页面由 MainActivity 注入，复用原 view_launch / view_sync） ═══ -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/segmentTrack" />

</androidx.constraintlayout.widget.ConstraintLayout>
