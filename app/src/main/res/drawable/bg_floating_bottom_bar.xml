<?xml version="1.0" encoding="utf-8"?>
<!--
  iOS 风格悬浮毛玻璃底栏背景
  - 深石墨半透明（#C0121212）
  - 32dp 大胶囊圆角
  - 1px 半透明白色描边
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/bg_floating_bar" />
    <corners android:radius="@dimen/dark_floating_bar_radius" />
    <stroke
        android:width="@dimen/dark_stroke_width"
        android:color="@color/stroke_glass" />
</shape>
