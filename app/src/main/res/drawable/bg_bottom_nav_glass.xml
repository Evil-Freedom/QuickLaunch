<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 主体：深色半透明毛玻璃感 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/car_bottom_nav_bg" />
            <corners
                android:topLeftRadius="24dp"
                android:topRightRadius="24dp" />
        </shape>
    </item>
    <!-- 上沿微光描边 -->
    <item
        android:left="0dp"
        android:right="0dp"
        android:top="0dp"
        android:bottom="-2dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1px"
                android:color="@color/car_bottom_nav_stroke" />
            <corners
                android:topLeftRadius="24dp"
                android:topRightRadius="24dp" />
        </shape>
    </item>
</layer-list>
