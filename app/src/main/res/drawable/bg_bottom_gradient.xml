<?xml version="1.0" encoding="utf-8"?>
<!--
  底部渐变遮罩：贴合屏幕最底部，用于淡化悬浮药丸底栏后方的滚动内容文字，
  避免文字与底栏胶囊发生重叠穿透。
  颜色引用 colors.xml，消除硬编码。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="@color/bottom_gradient_solid"
        android:centerColor="#D90F0F0F"
        android:endColor="@color/bottom_gradient_transparent"
        android:type="linear" />
</shape>
