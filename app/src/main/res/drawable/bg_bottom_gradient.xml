<?xml version="1.0" encoding="utf-8"?>
<!--
  底部渐变遮罩：贴合屏幕最底部，用于淡化悬浮药丸底栏后方的滚动内容文字，
  避免文字与底栏胶囊发生重叠穿透。
  渐变方向：从下往上（angle=90），底部 100% 纯黑 -> 中间 85% 暗黑 -> 顶部完全透明。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#0F0F0F"
        android:centerColor="#D90F0F0F"
        android:endColor="#000F0F0F"
        android:type="linear" />
</shape>
