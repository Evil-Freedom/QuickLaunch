<?xml version="1.0" encoding="utf-8"?>
<!--
  网络安全策略。

  ## 为什么需要这个文件

  targetSdk 28+ 默认禁止明文 HTTP。而 VPS 通道在「调试」场景下需要走
  `adb reverse` + `http://127.0.0.1:port`（报文不出设备，只在 adb 隧道内），
  默认策略会直接抛 `Cleartext HTTP traffic not permitted`。

  ## 边界

  - `base-config` 明确 **cleartextTrafficPermitted=false**：公网地址一律要求 TLS。
    这一条比「不加配置文件」更严格 —— 不加时系统对 targetSdk<28 是默认放行的。
  - 只有回环地址（127.0.0.1 / localhost）允许明文：那是 adb 隧道内部，
    流量不经过任何网络接口，与「把配置明文发到公网」是两件事。

  这与 `VpsSettings.validateUrl` 的白名单完全一致：那边限制用户只能填 https
  或回环地址，这边限制系统只对回环地址放行明文。两层各管一头。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">[::1]</domain>
    </domain-config>
</network-security-config>
