<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      iOS 极质感设计 Token — 全局尺寸变量
      规则：基于 4dp 网格系统，关键尺寸 8/12/16/24/32/48/64/96
    -->

    <!-- 圆角系统 -->
    <dimen name="ios_radius_xs">8dp</dimen>
    <dimen name="ios_radius_sm">12dp</dimen>
    <dimen name="ios_radius_md">16dp</dimen>
    <dimen name="ios_radius_lg">24dp</dimen>
    <dimen name="ios_radius_xl">32dp</dimen>
    <dimen name="ios_radius_pill">999dp</dimen>

    <!-- 间距系统 -->
    <dimen name="ios_space_xs">4dp</dimen>
    <dimen name="ios_space_sm">8dp</dimen>
    <dimen name="ios_space_md">12dp</dimen>
    <dimen name="ios_space_lg">16dp</dimen>
    <dimen name="ios_space_xl">24dp</dimen>
    <dimen name="ios_space_2xl">32dp</dimen>
    <dimen name="ios_space_3xl">48dp</dimen>

    <!-- 组件高度 -->
    <dimen name="ios_search_height">48dp</dimen>
    <dimen name="ios_dock_height">96dp</dimen>
    <dimen name="ios_fab_size">56dp</dimen>
    <dimen name="ios_button_height">50dp</dimen>

    <!-- 图标尺寸 -->
    <dimen name="ios_icon_sm">24dp</dimen>
    <dimen name="ios_icon_md">32dp</dimen>
    <dimen name="ios_icon_lg">48dp</dimen>
    <dimen name="ios_icon_xl">64dp</dimen>
    <dimen name="ios_dock_icon">56dp</dimen>

    <!-- 文字 -->
    <dimen name="ios_text_caption">12sp</dimen>
    <dimen name="ios_text_body">14sp</dimen>
    <dimen name="ios_text_subhead">16sp</dimen>
    <dimen name="ios_text_title">20sp</dimen>
    <dimen name="ios_text_large_title">28sp</dimen>

    <!-- 阴影/描边 -->
    <dimen name="ios_border_hairline">1px</dimen>
    <dimen name="ios_border_thin">1dp</dimen>
    <dimen name="ios_elevation_low">2dp</dimen>
    <dimen name="ios_elevation_md">4dp</dimen>
    <dimen name="ios_elevation_high">8dp</dimen>
</resources>
