        <item name="colorSurface">@color/preset_mint_surface</item>
        <item name="colorOnSurface">@color/preset_mint_on_surface</item>
        <item name="colorSurfaceVariant">@color/preset_mint_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/preset_mint_on_surface_variant</item>
        <item name="colorOutline">@color/preset_mint_outline</item>
