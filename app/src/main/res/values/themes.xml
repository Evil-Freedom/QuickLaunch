<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      M3 主题：完整映射 m3_* 色板到 Material 3 属性。
      - android:windowBackground 显式指定 m3_background（night 感知）：冷启动/切深色瞬间
        窗口不再默认白底，杜绝「白闪」。
      - android:forceDarkAllowed=false：防止系统强暗把 M3 深色再叠一遍（二次变暗）。
      - targetSdk 35+ 起 android:statusBarColor / navigationBarColor 已失效（系统强制边到边），
        这里不再设置，改由 Activity 中消费 WindowInsets 来避让状态栏与导航栏。
    -->

    <!-- ════════════════════════════════════════════════════════════════
         默认主题（薄荷绿）—— 向后兼容，指向 preset_mint 颜色
         ════════════════════════════════════════════════════════════════ -->
    <style name="Theme.QuickLaunch" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/preset_mint_primary</item>
        <item name="colorOnPrimary">@color/preset_mint_on_primary</item>
        <item name="colorPrimaryContainer">@color/preset_mint_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/preset_mint_on_primary_container</item>
        <item name="colorSecondary">@color/preset_mint_secondary</item>
        <item name="colorOnSecondary">@color/preset_mint_on_secondary</item>
        <item name="colorSecondaryContainer">@color/preset_mint_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/preset_mint_on_secondary_container</item>
        <item name="colorTertiary">@color/preset_mint_tertiary</item>
        <item name="colorOnTertiary">@color/preset_mint_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/preset_mint_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/preset_mint_on_tertiary_container</item>
        <item name="colorError">@color/preset_mint_error</item>
        <item name="colorOnError">@color/preset_mint_on_error</item>
        <item name="colorErrorContainer">@color/preset_mint_error_container</item>
        <item name="colorOnErrorContainer">@color/preset_mint_on_error_container</item>
        <item name="android:colorBackground">@color/preset_mint_background</item>
        <item name="colorOnBackground">@color/preset_mint_on_background</item>
        <item name="colorSurface">@color/preset_mint_surface</item>
        <item name="colorOnSurface">@color/preset_mint_on_surface</item>
        <item name="colorSurfaceVariant">@color/preset_mint_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/preset_mint_on_surface_variant</item>
        <item name="colorOutline">@color/preset_mint_outline</item>
        <item name="colorOutlineVariant">@color/preset_mint_outline_variant</item>
        <item name="colorSurfaceContainerLow">@color/preset_mint_surface</item>
        <item name="colorSurfaceContainer">@color/preset_mint_surface</item>
        <item name="colorSurfaceContainerHigh">@color/preset_mint_surface_variant</item>
        <item name="colorSurfaceInverse">@color/preset_mint_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/preset_mint_inverse_on_surface</item>
        <item name="colorPrimaryInverse">@color/preset_mint_inverse_primary</item>
        <item name="android:windowBackground">@color/preset_mint_background</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
    </style>

