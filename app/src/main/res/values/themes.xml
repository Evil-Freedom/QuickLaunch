        <item name="colorTertiary">@color/preset_lavender_tertiary</item>
        <item name="colorOnTertiary">@color/preset_lavender_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/preset_lavender_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/preset_lavender_on_tertiary_container</item>
        <item name="colorError">@color/preset_lavender_error</item>
        <item name="colorOnError">@color/preset_lavender_on_error</item>
        <item name="colorErrorContainer">@color/preset_lavender_error_container</item>
        <item name="colorOnErrorContainer">@color/preset_lavender_on_error_container</item>
        <item name="android:colorBackground">@color/preset_lavender_background</item>
        <item name="colorOnBackground">@color/preset_lavender_on_background</item>
        <item name="colorSurface">@color/preset_lavender_surface</item>
        <item name="colorOnSurface">@color/preset_lavender_on_surface</item>
        <item name="colorSurfaceVariant">@color/preset_lavender_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/preset_lavender_on_surface_variant</item>
        <item name="colorOutline">@color/preset_lavender_outline</item>
        <item name="colorOutlineVariant">@color/preset_lavender_outline_variant</item>
        <item name="colorSurfaceContainerLow">@color/preset_lavender_surface</item>
        <item name="colorSurfaceContainer">@color/preset_lavender_surface</item>
        <item name="colorSurfaceContainerHigh">@color/preset_lavender_surface_variant</item>
        <item name="colorSurfaceInverse">@color/preset_lavender_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/preset_lavender_inverse_on_surface</item>
        <item name="colorPrimaryInverse">@color/preset_lavender_inverse_primary</item>
        <item name="android:windowBackground">@color/preset_lavender_background</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
    </style>

    <!-- ════════════════════════════════════════════════════════════════
         经典绿主题（Classic）—— 沉稳、传统 Android 绿
         ════════════════════════════════════════════════════════════════ -->
    <style name="Theme.QuickLaunch.Classic" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/preset_classic_primary</item>
        <item name="colorOnPrimary">@color/preset_classic_on_primary</item>
        <item name="colorPrimaryContainer">@color/preset_classic_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/preset_classic_on_primary_container</item>
        <item name="colorSecondary">@color/preset_classic_secondary</item>
        <item name="colorOnSecondary">@color/preset_classic_on_secondary</item>
        <item name="colorSecondaryContainer">@color/preset_classic_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/preset_classic_on_secondary_container</item>
        <item name="colorTertiary">@color/preset_classic_tertiary</item>
        <item name="colorOnTertiary">@color/preset_classic_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/preset_classic_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/preset_classic_on_tertiary_container</item>
        <item name="colorError">@color/preset_classic_error</item>
        <item name="colorOnError">@color/preset_classic_on_error</item>
        <item name="colorErrorContainer">@color/preset_classic_error_container</item>
        <item name="colorOnErrorContainer">@color/preset_classic_on_error_container</item>
        <item name="android:colorBackground">@color/preset_classic_background</item>
        <item name="colorOnBackground">@color/preset_classic_on_background</item>
        <item name="colorSurface">@color/preset_classic_surface</item>
        <item name="colorOnSurface">@color/preset_classic_on_surface</item>
        <item name="colorSurfaceVariant">@color/preset_classic_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/preset_classic_on_surface_variant</item>
        <item name="colorOutline">@color/preset_classic_outline</item>
        <item name="colorOutlineVariant">@color/preset_classic_outline_variant</item>
        <item name="colorSurfaceContainerLow">@color/preset_classic_surface</item>
        <item name="colorSurfaceContainer">@color/preset_classic_surface</item>
        <item name="colorSurfaceContainerHigh">@color/preset_classic_surface_variant</item>
        <item name="colorSurfaceInverse">@color/preset_classic_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/preset_classic_inverse_on_surface</item>
        <item name="colorPrimaryInverse">@color/preset_classic_inverse_primary</item>
        <item name="android:windowBackground">@color/preset_classic_background</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
    </style>

    <!-- ════════════════════════════════════════════════════════════════
         暗黑极简胶囊主题（Dark）—— OLED 纯黑 + 深灰胶囊 + 苹果绿
         ════════════════════════════════════════════════════════════════ -->
    <style name="Theme.QuickLaunch.Dark" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- 主色：苹果绿 -->
        <item name="colorPrimary">@color/dark_accent_green</item>
        <item name="colorOnPrimary">@color/dark_bg_primary</item>
        <item name="colorPrimaryContainer">@color/dark_accent_green</item>
        <item name="colorOnPrimaryContainer">@color/dark_bg_primary</item>

        <!-- 次要色：深灰 -->
        <item name="colorSecondary">@color/dark_card_primary</item>
        <item name="colorOnSecondary">@color/dark_text_primary</item>
        <item name="colorSecondaryContainer">@color/dark_card_secondary</item>
        <item name="colorOnSecondaryContainer">@color/dark_text_primary</item>

        <!-- 第三色：浅灰 -->
        <item name="colorTertiary">@color/dark_text_secondary</item>
        <item name="colorOnTertiary">@color/dark_bg_primary</item>
        <item name="colorTertiaryContainer">@color/dark_divider</item>
        <item name="colorOnTertiaryContainer">@color/dark_text_primary</item>

        <!-- 错误色 -->
        <item name="colorError">#FF453A</item>
        <item name="colorOnError">@color/white</item>
        <item name="colorErrorContainer">#3A2A2A</item>
        <item name="colorOnErrorContainer">#FF453A</item>

        <!-- 背景：OLED 纯黑 -->
        <item name="android:colorBackground">@color/dark_bg_primary</item>
        <item name="colorOnBackground">@color/dark_text_primary</item>
        <item name="colorSurface">@color/dark_bg_primary</item>
        <item name="colorOnSurface">@color/dark_text_primary</item>
        <item name="colorSurfaceVariant">@color/dark_card_primary</item>
        <item name="colorOnSurfaceVariant">@color/dark_text_primary</item>
        <item name="colorOutline">@color/dark_divider</item>
        <item name="colorOutlineVariant">@color/dark_divider</item>
        <item name="colorSurfaceContainerLow">@color/dark_bg_primary</item>
        <item name="colorSurfaceContainer">@color/dark_card_primary</item>
        <item name="colorSurfaceContainerHigh">@color/dark_card_secondary</item>
        <item name="colorSurfaceInverse">@color/dark_text_primary</item>
        <item name="colorOnSurfaceInverse">@color/dark_bg_primary</item>
        <item name="colorPrimaryInverse">@color/dark_accent_green</item>

        <!-- 窗口背景：统一 bg_root #121212，冷启动瞬间就是最终底色，无跳色 -->
        <item name="android:windowBackground">@color/bg_root</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>

        <!-- ═══════════════ Edge-to-Edge 沉浸式 ═══════════════
             状态栏 / 导航栏全透明，窗口自绘系统栏背景，内容延伸到屏幕物理边缘。
             系统栏留白由 Activity 消费 WindowInsets 施加 padding，不靠主题色块顶。
             注意：网上常写的 windowDrawsSystemBarOverlays 并不存在，
             真实属性名是 android:windowDrawsSystemBarBackgrounds。 -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:navigationBarDividerColor" tools:targetApi="28">@android:color/transparent</item>
        <!-- 暗底 → 系统图标必须是浅色 -->
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <!-- 关闭系统自动补的半透明对比遮罩，否则底部会出现一条灰带，
             正是「底部导航栏硬边割裂感」的元凶 -->
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <!-- 挖孔屏延伸绘制；cutout 留白同样由 Insets 消费 -->
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="27">shortEdges</item>

        <!-- 纤细无衬线字体 -->
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textAppearance">@style/TextAppearance.QuickLaunch.Body</item>
    </style>

    <!-- ════════════════════════════════════════════════════════════════
         iOS 极质感主题（iOS18）—— 无边框沉浸式、毛玻璃、纤细字体
         ════════════════════════════════════════════════════════════════ -->
    <style name="Theme.QuickLaunch.iOS18" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- 主色使用薄荷绿 -->
        <item name="colorPrimary">@color/preset_mint_primary</item>
        <item name="colorOnPrimary">@color/preset_mint_on_primary</item>
        <item name="colorPrimaryContainer">@color/preset_mint_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/preset_mint_on_primary_container</item>
        <item name="colorSecondary">@color/preset_mint_secondary</item>
        <item name="colorOnSecondary">@color/preset_mint_on_secondary</item>
        <item name="colorSecondaryContainer">@color/preset_mint_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/preset_mint_on_secondary_container</item>
        <item name="colorTertiary">@color/preset_mint_tertiary</item>
        <item name="colorOnTertiary">@color/preset_mint_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/preset_mint_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/preset_mint_on_tertiary_container</item>
        <item name="colorError">@color/preset_mint_error</item>
        <item name="colorOnError">@color/preset_mint_on_error</item>
        <item name="colorErrorContainer">@color/preset_mint_error_container</item>
        <item name="colorOnErrorContainer">@color/preset_mint_on_error_container</item>

        <!-- 背景透明（毛玻璃 View 自行绘制半透明背景） -->
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="colorOnBackground">@color/preset_mint_on_background</item>
        <item name="colorSurface">@android:color/transparent</item>
        <item name="colorOnSurface">@color/preset_mint_on_surface</item>
        <item name="colorSurfaceVariant">@color/preset_mint_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/preset_mint_on_surface_variant</item>
        <item name="colorOutline">@color/preset_mint_outline</item>
        <item name="colorOutlineVariant">@color/preset_mint_outline_variant</item>
        <item name="colorSurfaceContainerLow">@android:color/transparent</item>
        <item name="colorSurfaceContainer">@android:color/transparent</item>
        <item name="colorSurfaceContainerHigh">@color/preset_mint_surface_variant</item>
        <item name="colorSurfaceInverse">@color/preset_mint_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/preset_mint_inverse_on_surface</item>
        <item name="colorPrimaryInverse">@color/preset_mint_inverse_primary</item>

        <!-- 无边框沉浸式：窗口背景透明，View 自行消费 Insets -->
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>

        <!-- 禁用系统强制暗色 -->
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>

        <!-- 纤细无衬线字体 -->
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textAppearance">@style/TextAppearance.QuickLaunch.Body</item>
    </style>

    <!-- 透明中转页专用：一闪而过绝不留白，合盖外屏触发时也无缝。
         windowIsTranslucent 在 targetSdk 35+ 下自动豁免边到边强制，无需消费 Insets。 -->
    <style name="Theme.QuickLaunch.Transparent" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:colorPrimary">@color/preset_mint_primary</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
    </style>

    <!-- 暗黑 BottomSheetDialog 主题（时间选择器 / 应用选择器共用） -->
    <style name="DarkBottomSheetDialogTheme" parent="Theme.Material3.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/DarkBottomSheetStyle</item>
        <item name="android:windowIsFloating">false</item>
        <!-- 全遮罩渐变背景，彻底盖住下方页面，消除半屏悬浮的割裂感 -->
        <item name="android:windowBackground">@drawable/bg_dialog_scrim</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!-- 与主题保持一致：抽屉弹出时导航栏也保持全透明，不再出现硬边灰带 -->
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
    </style>

    <style name="DarkBottomSheetStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/dark_bg_primary</item>
        <item name="shapeAppearance">@style/DarkBottomSheetShape</item>
    </style>

    <!-- 28dp 大圆角，四个角统一，居中或全屏展开都保持一致的胶囊感 -->
    <style name="DarkBottomSheetShape" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

</resources>
