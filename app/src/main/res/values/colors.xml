    <!-- inverse -->
    <color name="m3_inverse_surface">#2E322B</color>
    <color name="m3_inverse_on_surface">#F0F4EA</color>
    <color name="m3_inverse_primary">#8BD5C0</color>

    <!-- 业务色：状态色点（薄荷绿主题下的高对比度版本） -->
    <color name="status_enabled">#3D8B6F</color>
    <!-- 停用灰：vs 卡片底 #EFF6F1 对比度 4.91:1 -->
    <color name="status_disabled">#5A6B62</color>

    <!-- 自适应图标渐变背景（薄荷绿渐变） -->
    <color name="ic_launcher_bg_top">#5EA88B</color>
    <color name="ic_launcher_bg_bottom">#2D6B52</color>
    <!-- 闪电内高光（与图标背景同色系） -->
    <color name="ic_launcher_lightning_highlight">#B8E6D4</color>

