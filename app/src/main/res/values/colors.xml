<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ═══════════════════════════════════════════════════════════════
         车机质感暗色主题色板（Car Dashboard Dark）
         深邃夜空暗蓝 → 纯黑渐变背景 + 深灰蓝立体卡片 + 微光描边
         高亮色：#34C759（状态绿）/ #007AFF（苹果蓝）
         ═══════════════════════════════════════════════════════════════ -->

    <!-- 根背景：深邃夜空暗蓝，与渐变底对齐 -->
    <color name="dark_root">#0F111A</color>
    <color name="dark_bg_primary">#0F111A</color>

    <!-- 一阶卡片背景：深色立体卡片 -->
    <color name="dark_card_primary">#1C1E26</color>
    <!-- 二阶容器/输入框背景 -->
    <color name="dark_card_secondary">#252833</color>
    <!-- 深色按钮/选项背景 -->
    <color name="dark_button_bg">#252833</color>
    <!-- 深色分割线 -->
    <color name="dark_divider">#2C2E3A</color>
    <!-- 微光描边 -->
    <color name="dark_stroke">#333542</color>
    <!-- 输入框/选择框背景 -->
    <color name="dark_input_bg">@color/dark_card_secondary</color>
    <!-- 搜索框背景 -->
    <color name="dark_search_bg">#1F2129</color>

    <!-- 主文字（纯白） -->
    <color name="dark_text_primary">#FFFFFF</color>
    <!-- 次要文字（浅灰） -->
    <color name="dark_text_secondary">#A1A1AA</color>
    <!-- 辅助文字（更暗） -->
    <color name="dark_text_tertiary">#71717A</color>
    <!-- 占位符/提示文字 -->
    <color name="dark_text_hint">#4A4D5A</color>

    <!-- 品牌强调色：状态绿（电量进度、开启态） -->
    <color name="dark_accent">#34C759</color>
    <color name="dark_accent_green">#34C759</color>
    <color name="dark_accent_press">#2DBD4E</color>
    <!-- 苹果蓝（选中态、高亮） -->
    <color name="dark_accent_blue">#007AFF</color>

    <!-- Switch 控件颜色 -->
    <color name="dark_switch_thumb">#34C759</color>
    <color name="dark_switch_track">#333542</color>

    <!-- 危险/删除 -->
    <color name="dark_destructive">#FF453A</color>

    <!-- 底部导航毛玻璃背景：带透明度的深色 -->
    <color name="car_bottom_nav_bg">#C0121212</color>
    <!-- 底栏上沿微光 -->
    <color name="car_bottom_nav_stroke">#333542</color>

    <!-- 白色/黑色 -->
    <color name="white">#FFFFFFFF</color>
    <color name="black">#FF000000</color>

</resources>
