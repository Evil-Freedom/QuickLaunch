<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      M3 主题色板（光模式）—— 薄荷绿默认主题。
      品牌种子色：清新薄荷绿 #5EA88B，比经典绿更柔和、现代。
      所有颜色均满足 WCAG AA 对比度标准（正文 ≥4.5:1，非文本 ≥3:1）。
      深色差异统一写在 values-night/colors.xml 同名覆盖。
    -->

    <!-- primary（品牌主色 - 薄荷绿） -->
    <color name="m3_primary">#5EA88B</color>
    <color name="m3_on_primary">#FFFFFF</color>
    <color name="m3_primary_container">#B8E6D4</color>
    <color name="m3_on_primary_container">#00210A</color>

    <!-- secondary -->
    <color name="m3_secondary">#52634D</color>
    <color name="m3_on_secondary">#FFFFFF</color>
    <color name="m3_secondary_container">#D5E8CB</color>
    <color name="m3_on_secondary_container">#121F0E</color>

    <!-- tertiary（数据源 tag 等点缀色 - 薄荷绿族） -->
    <color name="m3_tertiary">#3A6B5A</color>
    <color name="m3_on_tertiary">#FFFFFF</color>
    <color name="m3_tertiary_container">#B2D8CB</color>
    <color name="m3_on_tertiary_container">#002019</color>

    <!-- error -->
    <color name="m3_error">#BA1A1A</color>
    <color name="m3_on_error">#FFFFFF</color>
    <color name="m3_error_container">#FFDAD6</color>
    <color name="m3_on_error_container">#410002</color>

    <!-- background / surface -->
    <color name="m3_background">#F5FBF7</color>
    <color name="m3_on_background">#191D17</color>
    <color name="m3_surface">#F5FBF7</color>
    <color name="m3_on_surface">#191D17</color>
    <color name="m3_surface_variant">#D9E5DD</color>
    <color name="m3_on_surface_variant">#43483E</color>

    <!-- outline -->
    <color name="m3_outline">#6F7972</color>
    <color name="m3_outline_variant">#C3C9BC</color>

    <!-- surface container 层级（操作区卡片等） -->
    <color name="m3_surface_container_lowest">#FFFFFF</color>
    <color name="m3_surface_container_low">#EFF6F1</color>
    <color name="m3_surface_container">#E9F1EB</color>
    <color name="m3_surface_container_high">#E3ECE6</color>
