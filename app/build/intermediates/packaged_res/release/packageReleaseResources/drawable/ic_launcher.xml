<?xml version="1.0" encoding="utf-8"?>
<!--
  API 24-25 兜底图标：渐变薄荷绿底 + 精致白闪电。
  与 adaptive icon 视觉一致（仅无安全区缩放），保证低版本体验统一。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 渐变背景 -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="@color/ic_launcher_bg_top"
                android:endColor="@color/ic_launcher_bg_bottom" />
        </aapt:attr>
    </path>
    <!-- 顶部高光 -->
    <path
        android:fillColor="#22FFFFFF"
        android:pathData="M0,0 L108,0 L108,42 Q54,54 0,42 Z" />
    <!-- 主闪电（白色）- 更精致的路径 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M62,20 L34,56 L52,56 L44,88 L76,44 L56,44 Z" />
    <!-- 闪电内高光（薄荷绿）- 增加层次感 -->
    <path
        android:fillColor="@color/ic_launcher_lightning_highlight"
        android:pathData="M60,28 L44,50 L54,50 L48,72 L64,50 L54,50 Z" />
</vector>
