<?xml version="1.0" encoding="utf-8"?>
<!--
  iOS 26 Liquid Glass 节假日项
  - 毛玻璃背景
  - 大圆角
  - iOS 纤细文字
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/ios_space_lg"
    android:layout_marginVertical="@dimen/ios_space_sm"
    android:background="@drawable/bg_liquid_glass"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/ios_space_lg">

    <TextView
        android:id="@+id/tvDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.QuickLaunch.Subhead"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.QuickLaunch.Body" />

    <Button
        android:id="@+id/btnDelete"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/ios_button_height"
        android:minHeight="@dimen/ios_button_height"
        android:text="删除" />

</LinearLayout>
