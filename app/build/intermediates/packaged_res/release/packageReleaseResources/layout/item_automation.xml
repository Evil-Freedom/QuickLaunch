<?xml version="1.0" encoding="utf-8"?>
<!--
  iOS 26 Liquid Glass 自动化规则项
  - 毛玻璃卡片
  - 纤细文字
  - iOS 风格开关
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/ios_space_lg"
    android:layout_marginVertical="@dimen/ios_space_sm"
    app:cardBackgroundColor="@color/ios_glass_surface_light"
    app:cardCornerRadius="@dimen/ios_radius_lg"
    app:cardElevation="0dp"
    app:strokeColor="@color/ios_glass_border"
    app:strokeWidth="@dimen/ios_border_hairline">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/ios_space_lg">

        <!-- 顶行：状态色点 + 名称 + 开关 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/vStatusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/status_dot_on" />

            <TextView
                android:id="@+id/tvName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ios_space_md"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.QuickLaunch.Subhead"
                android:textStyle="bold" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchEnabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- 描述行 -->
        <TextView
            android:id="@+id/tvDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ios_space_sm"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.QuickLaunch.Caption" />

        <!-- 删除按钮：iOS 风格 -->
        <Button
            android:id="@+id/btnDelete"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/ios_button_height"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/ios_space_sm"
            android:minHeight="@dimen/ios_button_height"
            android:text="删除" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
