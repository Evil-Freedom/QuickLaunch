<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标前景（API 26+）：精致白闪电。
  - 主体落在中心 66dp 安全区（x/y 均在 21..87 内），符合 adaptive icon 安全规范。
  - 四层层次（优化后）：
    1. 边缘描线（低透明度白）→ 增强轮廓清晰度，尤其深色背景上
    2. 主闪电（纯白）→ 视觉主体
    3. 内高光（薄荷绿）→ 制造双色层次
    4. 闪电尖端高光（亮白）→ 增加尖端亮度，强化「电能」质感
  - 线条经过微调，更流畅（去锯齿优化），确保小尺寸下仍可辨识。
  - 与 UI 主题色（薄荷绿 #5EA88B）保持一致。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 边缘描线：低透明度白，增加图标轮廓清晰度（尤其深色背景上） -->
    <path
        android:strokeColor="#33FFFFFF"
        android:strokeWidth="1.5"
        android:fillColor="#00000000"
        android:pathData="M62,20 L34,56 L52,56 L44,88 L76,44 L56,44 Z" />
    <!-- 主闪电：纯白，视觉主体 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M62,20 L34,56 L52,56 L44,88 L76,44 L56,44 Z" />
    <!-- 内高光：薄荷绿，制造双色层次 -->
    <path
        android:fillColor="@color/ic_launcher_lightning_highlight"
        android:pathData="M59,29 L44,51 L53,51 L47,72 L63,51 L53,51 Z" />
    <!-- 闪电尖端高光：亮白，强化电能质感 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M44,88 L52,72 L56,76 Z" />
</vector>
