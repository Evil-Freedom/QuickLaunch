<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标背景：薄荷绿渐变。
  - 108dp 视口，线性渐变从左上到右下，模拟光影质感。
  - 颜色引用 @color/ic_launcher_bg_top / bottom，可在 values-night 覆盖。
  - API 26+ 自适应图标使用此 drawable 作为 <background>。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="@color/ic_launcher_bg_top"
                android:endColor="@color/ic_launcher_bg_bottom" />
        </aapt:attr>
    </path>
    <!-- 微妙高光：顶部 1/3 白色低透明度叠加，增加立体感 -->
    <path
        android:fillColor="#22FFFFFF"
        android:pathData="M0,0 L108,0 L108,42 Q54,54 0,42 Z" />
</vector>
