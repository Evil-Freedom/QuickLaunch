<?xml version="1.0" encoding="utf-8"?>
<!-- iOS 26 搜索栏液态玻璃背景 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ios_glass_search_light" />
            <corners android:radius="@dimen/ios_radius_pill" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#50FFFFFF"
                android:type="linear" />
            <corners android:radius="@dimen/ios_radius_pill" />
            <stroke
                android:width="@dimen/ios_border_hairline"
                android:color="@color/ios_glass_border" />
        </shape>
    </item>
</layer-list>
