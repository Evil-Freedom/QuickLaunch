<?xml version="1.0" encoding="utf-8"?>
<!--
  iOS 26 应用网格项
  - Squircle 超椭圆图标（ShapeableImageView）
  - 图标下方应用名称
  - 长按弹出毛玻璃上下文菜单
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/ios_space_md">

    <!-- iOS Squircle 超椭圆图标 -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivAppIcon"
        android:layout_width="@dimen/ios_icon_xl"
        android:layout_height="@dimen/ios_icon_xl"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_empty_state"
        app:shapeAppearanceOverlay="@style/Widget.QuickLaunch.Icon.Squircle" />

    <!-- 应用名称 -->
    <TextView
        android:id="@+id/tvAppName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ios_space_sm"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.QuickLaunch.Caption" />

</LinearLayout>
