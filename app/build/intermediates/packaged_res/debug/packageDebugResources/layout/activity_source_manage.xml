<?xml version="1.0" encoding="utf-8"?>
<!--
  管理数据源界面 — Glassmorphism UI 重构
  - 数据源项：左侧 8dp 状态指示灯圆点 + 右侧状态 Badge
  - 底部纯白主按钮（46dp）
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dark_root">

    <!-- 标题卡片 -->
    <LinearLayout
        android:id="@+id/cardTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_liquid_glass_rim"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:text="管理数据源"
            android:textColor="@color/dark_text_primary"
            android:textSize="22sp" />
    </LinearLayout>

    <!-- 提示卡片 -->
    <LinearLayout
        android:id="@+id/cardHint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_liquid_glass_rim"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardTitle">

        <TextView
            android:id="@+id/tvHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:text="内置源已够用；你也可添加自己的节假日 API（网址里要有「年份」标记，如 2026）。"
            android:textColor="@color/dark_text_tertiary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:padding="12dp"
        android:paddingBottom="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardHint" />

    <!-- 悬浮添加按钮：46dp 纯白大胶囊 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/fabAdd"
        style="@style/Widget.QuickLaunch.Dark.Button.Primary"
        android:layout_width="0dp"
        android:layout_height="@dimen/glass_button_height"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:text="添加自定义数据源"
        app:icon="@drawable/ic_add_ios"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="280dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
