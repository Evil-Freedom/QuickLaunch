<?xml version="1.0" encoding="utf-8"?>
<!--
  Tab 1：快捷启动面板（纯白 + 半透灰白磨砂玻璃风格）
  - 扁平化重构：最大嵌套深度 ≤4 层（原 6 层）
  - 移除冗余背景，减少 GPU Overdraw
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/launchScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:paddingBottom="@dimen/dark_scroll_bottom_gap">

    <!-- 扁平化：根容器直接使用 ConstraintLayout（深度 1→2） -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- 页面标题 -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-light"
            android:text="我的自动化"
            android:textColor="@color/text_white"
            android:textSize="28sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 仪表盘：ConstraintLayout 扁平化（原 6 层→3 层） -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutDashboard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_elegant"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle">

            <!-- 左栏：已启用规则 -->
            <TextView
                android:id="@+id/tvDashboardLabelEnabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:text="已启用规则"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvDashboardEnabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif"
                android:text="0"
                android:textColor="@color/text_white"
                android:textFontWeight="600"
                android:textSize="22sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvDashboardLabelEnabled" />

            <!-- 分隔线 -->
            <View
                android:id="@+id/dashboardDivider"
                android:layout_width="1px"
                android:layout_height="0dp"
                android:layout_marginHorizontal="16dp"
                android:background="@color/stroke_hairline"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tvDashboardLabelNext"
                app:layout_constraintStart_toEndOf="@id/tvDashboardEnabled"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- 右栏：下次触发 -->
            <TextView
                android:id="@+id/tvDashboardLabelNext"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:text="下次触发"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/dashboardDivider"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvDashboardNext"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif"
                android:text="--:--"
                android:textColor="@color/text_white"
                android:textFontWeight="600"
                android:textSize="22sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/dashboardDivider"
                app:layout_constraintTop_toBottomOf="@id/tvDashboardLabelNext" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 触发条件标题 -->
        <TextView
            android:id="@+id/tvTriggerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.05"
            android:text="触发条件"
            android:textAllCaps="true"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutDashboard" />

        <!-- 触发条件：2x2 扁平化网格（原 4 层→2 层） -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutTriggerGrid"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTriggerTitle">

            <TextView
                android:id="@+id/chipTrigger0"
                style="@style/Widget.QuickLaunch.Dark.GridChip.Selected"
                android:layout_width="0dp"
                android:layout_height="@dimen/trigger_grid_item_height"
                android:layout_marginEnd="8dp"
                android:text="定时"
                app:layout_constraintEnd_toStartOf="@id/chipTrigger1"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/chipTrigger1"
                style="@style/Widget.QuickLaunch.Dark.GridChip"
                android:layout_width="0dp"
                android:layout_height="@dimen/trigger_grid_item_height"
                android:layout_marginStart="8dp"
                android:text="充电"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/chipTrigger0"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/chipTrigger2"
                style="@style/Widget.QuickLaunch.Dark.GridChip"
                android:layout_width="0dp"
                android:layout_height="@dimen/trigger_grid_item_height"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:text="WiFi"
                app:layout_constraintEnd_toStartOf="@id/chipTrigger3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/chipTrigger0" />

            <TextView
                android:id="@+id/chipTrigger3"
                style="@style/Widget.QuickLaunch.Dark.GridChip"
                android:layout_width="0dp"
                android:layout_height="@dimen/trigger_grid_item_height"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:text="蓝牙"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/chipTrigger2"
                app:layout_constraintTop_toBottomOf="@id/chipTrigger1" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 应用选择按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickApp"
            style="@style/Widget.QuickLaunch.Dark.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/dark_button_height"
            android:layout_marginTop="16dp"
            android:text="选择要启动的应用"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutTriggerGrid" />

        <!-- 时间设置分组卡片（深度 3） -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_elegant"
            android:padding="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnPickApp">

            <TextView
                android:id="@+id/tvTimeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:letterSpacing="0.05"
                android:text="执行时间"
                android:textAllCaps="true"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/btnTime"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/glass_time_bubble_height"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_dark_input"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="08:00"
                android:textColor="@color/text_white"
                android:textFontWeight="700"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvTimeTitle" />

            <TextView
                android:id="@+id/tvRepeatTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dark_section_gap"
                android:fontFamily="sans-serif-light"
                android:letterSpacing="0.05"
                android:text="重复"
                android:textAllCaps="true"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnTime" />

            <HorizontalScrollView
                android:id="@+id/scrollRepeat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvRepeatTitle">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipRepeat0"
                        style="@style/Widget.QuickLaunch.Dark.Chip.Selected"
                        android:text="每天" />

                    <TextView
                        android:id="@+id/chipRepeat1"
                        style="@style/Widget.QuickLaunch.Dark.Chip"
                        android:text="工作日" />

                    <TextView
                        android:id="@+id/chipRepeat2"
                        style="@style/Widget.QuickLaunch.Dark.Chip"
                        android:text="周末" />

                    <TextView
                        android:id="@+id/chipRepeat3"
                        style="@style/Widget.QuickLaunch.Dark.Chip"
                        android:text="自定义" />

                    <TextView
                        android:id="@+id/chipRepeat4"
                        style="@style/Widget.QuickLaunch.Dark.Chip"
                        android:text="一次性" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- 自定义星期多选（深度 4） -->
            <LinearLayout
                android:id="@+id/layoutCustomDays"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/scrollRepeat">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:text="选择星期（可多选）"
                    android:textColor="@color/text_tertiary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tbDay0"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dark_capsule_unselected"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:text="日"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tbDay1"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dark_capsule_unselected"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:text="一"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tbDay2"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dark_capsule_unselected"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:text="二"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tbDay3"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dark_capsule_unselected"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:text="三"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tbDay4"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dark_capsule_unselected"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:text="四"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tbDay5"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dark_capsule_unselected"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:text="五"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tbDay6"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dark_capsule_unselected"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:text="六"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 跳过节假日开关 -->
            <CheckBox
                android:id="@+id/cbSkipHolidays"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:button="@drawable/cb_glass"
                android:fontFamily="sans-serif-light"
                android:text="跳过中国法定节假日（含调休休息日）不触发"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layoutCustomDays" />

            <!-- 随机时间开关 -->
            <CheckBox
                android:id="@+id/cbRandom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:button="@drawable/cb_glass"
                android:fontFamily="sans-serif-light"
                android:text="随机时间（在窗口内，避免每天固定打卡）"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cbSkipHolidays" />

            <!-- 随机窗口时间（深度 4） -->
            <LinearLayout
                android:id="@+id/layoutRandom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cbRandom">

                <TextView
                    android:id="@+id/btnWinStart"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/glass_time_bubble_height"
                    android:layout_weight="1"
                    android:background="@drawable/bg_dark_input"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:text="08:30"
                    android:textColor="@color/text_white"
                    android:textFontWeight="700"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:fontFamily="sans-serif-light"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="至"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btnWinEnd"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/glass_time_bubble_height"
                    android:layout_weight="1"
                    android:background="@drawable/bg_dark_input"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:text="08:50"
                    android:textColor="@color/text_white"
                    android:textFontWeight="700"
                    android:textSize="14sp" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 蓝牙设备名卡片（深度 3） -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutBt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_elegant"
            android:padding="12dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutTime">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="蓝牙设备名（可选，留空表示任意设备）"
                android:textColorHint="@color/text_tertiary"
                app:boxBackgroundMode="none"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="0dp"
                app:hintTextColor="@color/text_tertiary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etBtName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:fontFamily="sans-serif-light"
                    android:inputType="text"
                    android:textColor="@color/text_white"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 保存按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveRule"
            style="@style/Widget.QuickLaunch.Dark.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/dark_button_height"
            android:layout_marginTop="16dp"
            android:text="保存规则"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutBt" />

        <!-- 规则列表标题 -->
        <TextView
            android:id="@+id/tvRuleListTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:fontFamily="sans-serif"
            android:text="规则列表"
            android:textColor="@color/text_caption"
            android:textFontWeight="700"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnSaveRule" />

        <!-- 空状态卡片 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutRulesEmpty"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_elegant"
            android:gravity="center"
            android:paddingTop="24dp"
            android:paddingBottom="24dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvRuleListTitle">

            <TextView
                android:id="@+id/tvRulesEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="还没有自动化规则"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRules"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:minHeight="120dp"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutRulesEmpty" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
