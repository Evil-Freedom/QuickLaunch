<?xml version="1.0" encoding="utf-8"?>
<!--
  规则编辑页 — Glassmorphism UI 重构
  - 触发条件四宫格瘦身（56dp，20dp 图标，13sp 文字）
  - 时间气泡精致化（40dp 高度，20dp 圆角）
  - 主按钮瘦身（46dp 纯白大胶囊）
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dark_root"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- 应用选择按钮：46dp 纯白大胶囊 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickApp"
            style="@style/Widget.QuickLaunch.Dark.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/glass_button_height"
            android:layout_marginTop="12dp"
            android:text="选择要启动的应用"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 蓝牙设备选择 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickBluetooth"
            style="@style/Widget.QuickLaunch.Dark.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/glass_button_height"
            android:layout_marginTop="12dp"
            android:text="选择蓝牙设备（可选）"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnPickApp" />

        <!-- Barrier：防止 btnPickBluetooth 为 gone 时触发条件卡片错位 -->
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrierAfterBtns"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="btnPickApp,btnPickBluetooth" />

        <!-- 触发条件分组卡片 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutTrigger"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_liquid_glass_rim"
            android:padding="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/barrierAfterBtns">

            <TextView
                android:id="@+id/tvTriggerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:letterSpacing="0.05"
                android:text="触发条件"
                android:textAllCaps="true"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- 触发条件四宫格：固定高度 56dp，20dp 图标，13sp 文字 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutTriggerGrid"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvTriggerTitle">

                <TextView
                    android:id="@+id/chipTrigger0"
                    style="@style/Widget.QuickLaunch.Dark.GridChip.Selected"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/trigger_grid_item_height"
                    android:layout_marginEnd="8dp"
                    android:text="定时"
                    app:layout_constraintEnd_toStartOf="@id/chipTrigger1"
                    app:layout_constraintHorizontal_chainStyle="spread"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/chipTrigger1"
                    style="@style/Widget.QuickLaunch.Dark.GridChip"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/trigger_grid_item_height"
                    android:layout_marginStart="8dp"
                    android:text="充电"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/chipTrigger0"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/chipTrigger2"
                    style="@style/Widget.QuickLaunch.Dark.GridChip"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/trigger_grid_item_height"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="8dp"
                    android:text="WiFi"
                    app:layout_constraintEnd_toStartOf="@id/chipTrigger3"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/chipTrigger0" />

                <TextView
                    android:id="@+id/chipTrigger3"
                    style="@style/Widget.QuickLaunch.Dark.GridChip"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/trigger_grid_item_height"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="8dp"
                    android:text="蓝牙"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/chipTrigger2"
                    app:layout_constraintTop_toBottomOf="@id/chipTrigger1" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- WiFi 设备选择：仅 WiFi 触发时显示 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickWifi"
            style="@style/Widget.QuickLaunch.Dark.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/glass_button_height"
            android:layout_marginTop="12dp"
            android:text="选择 WiFi 网络（可选）"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutTrigger" />

        <!-- Barrier：防止 btnPickWifi 为 gone 时时间设置卡片错位 -->
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrierAfterWifi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="layoutTrigger,btnPickWifi" />

        <!-- 时间设置分组卡片 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_liquid_glass_rim"
            android:padding="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/barrierAfterWifi">

            <TextView
                android:id="@+id/tvTimeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:text="执行时间"
                android:textAllCaps="true"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- 时间气泡：精致化（40dp 高度，20dp 圆角，.glass-active 样式） -->
            <TextView
                android:id="@+id/btnTime"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/glass_time_bubble_height"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_dark_input"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="08:00"
                android:textColor="@color/text_white"
                android:textFontWeight="700"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvTimeTitle" />

            <TextView
                android:id="@+id/tvRepeatTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dark_section_gap"
                android:fontFamily="sans-serif-light"
                android:letterSpacing="0.05"
                android:text="重复"
                android:textAllCaps="true"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnTime" />

            <HorizontalScrollView
                android:id="@+id/scrollRepeat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvRepeatTitle">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipRepeat0"
                        style="@style/Widget.QuickLaunch.Dark.Chip.Selected"
                        android:text="每天" />

                    <TextView
                        android:id="@+id/chipRepeat1"
                        style="@style/Widget.QuickLaunch.Dark.Chip"
                        android:text="工作日" />

                    <TextView
                        android:id="@+id/chipRepeat2"
                        style="@style/Widget.QuickLaunch.Dark.Chip"
                        android:text="周末" />

                    <TextView
                        android:id="@+id/chipRepeat3"
                        style="@style/Widget.QuickLaunch.Dark.Chip"
                        android:text="自定义" />

                    <TextView
                        android:id="@+id/chipRepeat4"
                        style="@style/Widget.QuickLaunch.Dark.Chip"
                        android:text="一次性" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- 自定义星期多选 -->
            <LinearLayout
                android:id="@+id/layoutCustomDays"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/scrollRepeat">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:text="选择星期（可多选）"
                    android:textColor="@color/text_tertiary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tbDay0"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dark_capsule_unselected"
                        android:fontFamily="sans-serif-light"
                        android:gravity="center"
                        android:text="日"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tbDay1"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dark_capsule_unselected"
                        android:fontFamily="sans-serif-light"
                        android:gravity="center"
                        android:text="一"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tbDay2"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dark_capsule_unselected"
                        android:fontFamily="sans-serif-light"
                        android:gravity="center"
                        android:text="二"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tbDay3"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dark_capsule_unselected"
                        android:fontFamily="sans-serif-light"
                        android:gravity="center"
                        android:text="三"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tbDay4"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dark_capsule_unselected"
                        android:fontFamily="sans-serif-light"
                        android:gravity="center"
                        android:text="四"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tbDay5"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dark_capsule_unselected"
                        android:fontFamily="sans-serif-light"
                        android:gravity="center"
                        android:text="五"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tbDay6"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dark_capsule_unselected"
                        android:fontFamily="sans-serif-light"
                        android:gravity="center"
                        android:text="六"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 选项分组卡片 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutOptions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_liquid_glass_rim"
            android:padding="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutTime">

            <CheckBox
                android:id="@+id/cbSkipHolidays"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:buttonTint="@color/text_white"
                android:fontFamily="sans-serif-light"
                android:text="跳过中国法定节假日（含调休休息日）不触发"
                android:textColor="@color/text_white"
                android:textSize="15sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <CheckBox
                android:id="@+id/cbRandom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:buttonTint="@color/text_white"
                android:fontFamily="sans-serif-light"
                android:text="随机时间（在窗口内，避免每天固定打卡）"
                android:textColor="@color/text_white"
                android:textSize="15sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cbSkipHolidays" />

            <LinearLayout
                android:id="@+id/layoutRandom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cbRandom">

                <TextView
                    android:id="@+id/btnWinStart"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/glass_time_bubble_height"
                    android:layout_weight="1"
                    android:background="@drawable/bg_dark_input"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:text="08:30"
                    android:textColor="@color/text_white"
                    android:textFontWeight="700"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:fontFamily="sans-serif-light"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="至"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btnWinEnd"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/glass_time_bubble_height"
                    android:layout_weight="1"
                    android:background="@drawable/bg_dark_input"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:text="08:50"
                    android:textColor="@color/text_white"
                    android:textFontWeight="700"
                    android:textSize="14sp" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 保存按钮：46dp 纯白大胶囊 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            style="@style/Widget.QuickLaunch.Dark.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/glass_button_height"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:text="保存"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutTime" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
