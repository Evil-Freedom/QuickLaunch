<?xml version="1.0" encoding="utf-8"?>
<!--
  Tab 1：快捷启动面板 — Glassmorphism UI 重构 v2
  - 顶部权限状态提醒卡片（动态展开/隐藏）
  - 仪表盘：LinearLayout weight=1 布局修复文字重叠
  - 扁平化重构：最大嵌套深度 ≤4 层
  - 底部预留 paddingBottom 100dp 避让悬浮底栏
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/launchScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:paddingBottom="@dimen/dark_scroll_bottom_gap">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- 页面标题 -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-light"
            android:text="我的自动化"
            android:textColor="@color/text_white"
            android:textSize="28sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- ═══ 权限状态提醒卡片（Glassmorphism .glass-panel）═══ -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardPermission"
            style="@style/Widget.QuickLaunch.Glass.PermissionCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle">

            <ImageView
                android:id="@+id/ivWarnIcon"
                android:layout_width="@dimen/glass_permission_card_icon"
                android:layout_height="@dimen/glass_permission_card_icon"
                android:contentDescription="警告"
                android:src="@drawable/ic_notification_stat"
                app:tint="@color/text_secondary"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvPermissionMsg"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="16dp"
                android:fontFamily="sans-serif-light"
                android:text="部分权限未全部开启"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnGoAuth"
                app:layout_constraintStart_toEndOf="@id/ivWarnIcon"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/btnGoAuth"
                style="@style/Widget.QuickLaunch.Glass.PermissionButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="去开启"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ═══ 仪表盘：LinearLayout weight=1 布局修复文字重叠 ═══ -->
        <LinearLayout
            android:id="@+id/layoutDashboard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_liquid_glass_rim"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardPermission">

            <!-- 左栏：已启用规则 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDashboardLabelEnabled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:text="已启用规则"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvDashboardEnabled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif"
                    android:text="0"
                    android:textColor="@color/text_white"
                    android:textFontWeight="600"
                    android:textSize="22sp" />
            </LinearLayout>

            <!-- 分隔线 -->
            <View
                android:layout_width="1px"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="16dp"
                android:background="@color/stroke_hairline" />

            <!-- 右栏：下次触发 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDashboardLabelNext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:text="下次触发"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvDashboardNext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif"
                    android:text="--:--"
                    android:textColor="@color/text_white"
                    android:textFontWeight="600"
                    android:textSize="22sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 触发条件标题 -->
        <TextView
            android:id="@+id/tvTriggerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.05"
            android:text="触发条件"
            android:textAllCaps="true"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutDashboard" />

        <!-- 触发条件：2x2 扁平化网格（56dp 高度） -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutTriggerGrid"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTriggerTitle">

            <TextView
                android:id="@+id/chipTrigger0"
                style="@style/Widget.QuickLaunch.Dark.GridChip.Selected"
                android:layout_width="0dp"
                android:layout_height="@dimen/trigger_grid_item_height"
                android:layout_marginEnd="8dp"
                android:text="定时"
                app:layout_constraintEnd_toStartOf="@id/chipTrigger1"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/chipTrigger1"
                style="@style/Widget.QuickLaunch.Dark.GridChip"
                android:layout_width="0dp"
                android:layout_height="@dimen/trigger_grid_item_height"
                android:layout_marginStart="8dp"
                android:text="充电"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/chipTrigger0"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/chipTrigger2"
                style="@style/Widget.QuickLaunch.Dark.GridChip"
                android:layout_width="0dp"
                android:layout_height="@dimen/trigger_grid_item_height"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:text="WiFi"
                app:layout_constraintEnd_toStartOf="@id/chipTrigger3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/chipTrigger0" />

            <TextView
                android:id="@+id/chipTrigger3"
                style="@style/Widget.QuickLaunch.Dark.GridChip"
                android:layout_width="0dp"
                android:layout_height="@dimen/trigger_grid_item_height"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:text="蓝牙"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/chipTrigger2"
                app:layout_constraintTop_toBottomOf="@id/chipTrigger1" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 应用选择按钮：46dp 纯白大胶囊（始终显示，主操作按钮） -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickApp"
            style="@style/Widget.QuickLaunch.Dark.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/glass_button_height"
            android:layout_marginTop="16dp"
            android:text="启动应用"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutTriggerGrid" />

        <!-- WiFi 设备选择按钮：仅 WiFi 触发时显示 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickWifi"
            style="@style/Widget.QuickLaunch.Dark.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/glass_button_height"
            android:layout_marginTop="16dp"
            android:text="选择 WiFi 网络（可选）"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnPickApp"
            android:visibility="gone" />

        <!-- 蓝牙设备选择卡片：仅蓝牙触发时显示 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickBluetooth"
            style="@style/Widget.QuickLaunch.Dark.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/glass_button_height"
            android:layout_marginTop="16dp"
            android:text="选择蓝牙设备（可选）"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnPickWifi"
            android:visibility="gone" />

        <!-- Barrier：将时间设置卡片锚定到「可见的最后一个按钮」下方，
             避免 btnPickWifi / btnPickBluetooth 为 gone 时链条错位 -->
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrierAfterButtons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="btnPickApp,btnPickWifi,btnPickBluetooth" />

        <!-- 时间设置分组卡片 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_liquid_glass_rim"
            android:padding="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/barrierAfterButtons">

            <TextView
                android:id="@+id/tvTimeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:letterSpacing="0.05"
                android:text="执行时间"
                android:textAllCaps="true"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- 时间气泡：40dp 高度，圆角 20dp -->
            <TextView
                android:id="@+id/btnTime"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/glass_time_bubble_height"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_dark_input"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="08:00"
                android:textColor="@color/text_white"
                android:textFontWeight="700"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvTimeTitle" />

            <TextView
                android:id="@+id/tvRepeatTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dark_section_gap"
                android:fontFamily="sans-serif-light"
                android:letterSpacing="0.05"
                android:text="重复"
                android:textAllCaps="true"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnTime" />

            <HorizontalScrollView
                android:id="@+id/scrollRepeat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvRepeatTitle">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipRepeat0"
                        style="@style/Widget.QuickLaunch.Dark.Chip.Selected"
                        android:text="每天" />

                    <TextView
                        android:id="@+id/chipRepeat1"
                        style="@style/Widget.QuickLaunch.Dark.Chip"
                        android:text="工作日" />

                    <TextView
                        android:id="@+id/chipRepeat2"
                        style="@style/Widget.QuickLaunch.Dark.Chip"
                        android:text="周末" />

                    <TextView
                        android:id="@+id/chipRepeat3"
                        style="@style/Widget.QuickLaunch.Dark.Chip"
                        android:text="自定义" />

                    <TextView
                        android:id="@+id/chipRepeat4"
                        style="@style/Widget.QuickLaunch.Dark.Chip"
                        android:text="一次性" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- 自定义星期多选 -->
            <LinearLayout
                android:id="@+id/layoutCustomDays"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/scrollRepeat">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:text="选择星期（可多选）"
                    android:textColor="@color/text_tertiary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tbDay0"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dark_capsule_unselected"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:text="日"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tbDay1"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dark_capsule_unselected"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:text="一"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tbDay2"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dark_capsule_unselected"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:text="二"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tbDay3"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dark_capsule_unselected"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:text="三"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tbDay4"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dark_capsule_unselected"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:text="四"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tbDay5"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dark_capsule_unselected"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:text="五"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tbDay6"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dark_capsule_unselected"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:text="六"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 跳过节假日开关 -->
            <CheckBox
                android:id="@+id/cbSkipHolidays"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:button="@drawable/cb_glass"
                android:fontFamily="sans-serif-light"
                android:text="跳过中国法定节假日（含调休休息日）不触发"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layoutCustomDays" />

            <!-- 随机时间开关 -->
            <CheckBox
                android:id="@+id/cbRandom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:button="@drawable/cb_glass"
                android:fontFamily="sans-serif-light"
                android:text="随机时间（在窗口内，避免每天固定打卡）"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cbSkipHolidays" />

            <!-- 随机窗口时间 -->
            <LinearLayout
                android:id="@+id/layoutRandom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cbRandom">

                <TextView
                    android:id="@+id/btnWinStart"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/glass_time_bubble_height"
                    android:layout_weight="1"
                    android:background="@drawable/bg_dark_input"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:text="08:30"
                    android:textColor="@color/text_white"
                    android:textFontWeight="700"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:fontFamily="sans-serif-light"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="至"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btnWinEnd"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/glass_time_bubble_height"
                    android:layout_weight="1"
                    android:background="@drawable/bg_dark_input"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:text="08:50"
                    android:textColor="@color/text_white"
                    android:textFontWeight="700"
                    android:textSize="14sp" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 保存按钮：46dp 纯白大胶囊 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveRule"
            style="@style/Widget.QuickLaunch.Dark.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/glass_button_height"
            android:layout_marginTop="16dp"
            android:text="保存规则"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutTime" />

        <!-- 规则列表标题 -->
        <TextView
            android:id="@+id/tvRuleListTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:fontFamily="sans-serif"
            android:text="规则列表"
            android:textColor="@color/text_caption"
            android:textFontWeight="700"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnSaveRule" />

        <!-- 空状态卡片 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutRulesEmpty"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_liquid_glass_rim"
            android:gravity="center"
            android:paddingTop="24dp"
            android:paddingBottom="24dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvRuleListTitle">

            <TextView
                android:id="@+id/tvRulesEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="还没有自动化规则"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRules"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:minHeight="120dp"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutRulesEmpty" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
