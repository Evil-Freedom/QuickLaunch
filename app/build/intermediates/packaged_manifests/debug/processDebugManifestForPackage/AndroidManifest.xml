<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.workbuddy.quicklaunch"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="36" />

    <!-- 开机自启后重新排程定时任务与网络回调 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 前台服务：用于在后台真正拉起目标 App -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+ 声明 specialUse 类型的前台服务必须同时申请此权限，否则运行时 SecurityException -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Android 13+ 通知权限 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 通知兜底时使用全屏 Intent，保证锁屏也能弹出 -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- 关键：Android 10+ 后台启动 Activity 的可靠豁免途径，无此权限自动拉起会被系统静默丢弃 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- WiFi 条件监听（registerNetworkCallback 需要） -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- 蓝牙条件监听 -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- 精确闹钟：SCHEDULE_EXACT_ALARM 需用户手动授权，USE_EXACT_ALARM（Android 13+）免授权 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- 同步中国法定节假日数据 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 唤醒与忽略电池优化 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
      targetSdk 30+ 的包可见性限制：不声明 queries 就查不到其它应用，
      应用选择列表会是空的、getLaunchIntentForPackage 也会返回 null。
      只声明 LAUNCHER 意图即可（比 QUERY_ALL_PACKAGES 更克制，也不会被应用商店拒审）。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />

            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <permission
        android:name="com.workbuddy.quicklaunch.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.workbuddy.quicklaunch.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.QuickLaunch.Dark" >
        <activity
            android:name="com.workbuddy.quicklaunch.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.QuickLaunch.Dark" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.workbuddy.quicklaunch.CreateAutomationActivity"
            android:exported="false"
            android:theme="@style/Theme.QuickLaunch.Dark" />
        <activity
            android:name="com.workbuddy.quicklaunch.HolidayManageActivity"
            android:exported="false"
            android:theme="@style/Theme.QuickLaunch.Dark" />
        <activity
            android:name="com.workbuddy.quicklaunch.SourceManageActivity"
            android:exported="false"
            android:theme="@style/Theme.QuickLaunch.Dark" />
        <activity
            android:name="com.workbuddy.quicklaunch.ThemeSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.QuickLaunch.Dark" />

        <!--
             透明中转页：定时/条件触发时先拉起它，由它选屏 + 点亮屏幕 + 绕过锁屏后启动目标 App。
             exported=false 足够——它由本应用的前台服务与通知 PendingIntent 唤起，无需对外暴露。
        -->
        <activity
            android:name="com.workbuddy.quicklaunch.LaunchProxyActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:theme="@style/Theme.QuickLaunch.Transparent"
            android:turnScreenOn="true" />

        <!-- 真正拉起目标 App 的前台服务 -->
        <service
            android:name="com.workbuddy.quicklaunch.service.LaunchService"
            android:exported="false"
            android:foregroundServiceType="specialUse" >
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="用户自定义规则触发时自动启动指定应用" />
        </service>

        <!-- 后台保活前台服务：长驻降低被杀概率，保障自动启动规则可靠触发 -->
        <service
            android:name="com.workbuddy.quicklaunch.service.KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse" >
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="后台保活，保障自动启动规则可靠触发" />
        </service>

        <!-- 定时触发（显式 PendingIntent，无需导出） -->
        <receiver
            android:name="com.workbuddy.quicklaunch.receiver.AlarmReceiver"
            android:exported="false" />

        <!-- WiFi 触发：由 registerNetworkCallback 的显式 PendingIntent 唤起，不需要 intent-filter -->
        <receiver
            android:name="com.workbuddy.quicklaunch.receiver.WifiReceiver"
            android:exported="false" />

        <!-- 开机完成：重新注册定时任务与网络回调 -->
        <receiver
            android:name="com.workbuddy.quicklaunch.receiver.BootReceiver"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 充电触发：ACTION_POWER_CONNECTED 属系统豁免广播，静态注册有效 -->
        <receiver
            android:name="com.workbuddy.quicklaunch.receiver.PowerConnectionReceiver"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
            </intent-filter>
        </receiver>

        <!-- 蓝牙触发：ACL_CONNECTED 同属豁免广播 -->
        <receiver
            android:name="com.workbuddy.quicklaunch.receiver.BluetoothReceiver"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.workbuddy.quicklaunch.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <service
            android:name="androidx.room.MultiInstanceInvalidationService"
            android:directBootAware="true"
            android:exported="false" />

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>