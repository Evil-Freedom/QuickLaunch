<?xml version="1.0" encoding="utf-8"?>
<!--
  数据源项 — Glassmorphism UI 重构
  - 左侧 8dp 状态指示灯圆点（已同步绿色 / 未同步灰色）
  - 右侧状态 Badge（成功 / 未同步）
  - 圆角 28dp，毛玻璃卡片
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="5dp"
    app:cardBackgroundColor="@color/glass_card_bg"
    app:cardCornerRadius="@dimen/dark_radius_card"
    app:cardElevation="0dp"
    app:cardUseCompatPadding="false"
    app:strokeColor="@color/glass_active_stroke"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- 左侧状态指示灯圆点（8dp） -->
        <View
            android:id="@+id/vStatusDot"
            android:layout_width="@dimen/glass_status_dot_size"
            android:layout_height="@dimen/glass_status_dot_size"
            android:background="@drawable/status_dot_synced"
            app:layout_constraintBottom_toBottomOf="@id/tvLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvLabel" />

        <TextView
            android:id="@+id/tvLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:textAppearance="@style/TextAppearance.QuickLaunch.Subhead"
            android:textColor="@color/text_white"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/btnDelete"
            app:layout_constraintStart_toEndOf="@id/vStatusDot"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvUrl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.QuickLaunch.Caption"
            android:textColor="@color/text_secondary"
            app:layout_constraintEnd_toStartOf="@id/btnDelete"
            app:layout_constraintStart_toEndOf="@id/vStatusDot"
            app:layout_constraintTop_toBottomOf="@id/tvLabel" />

        <!-- 状态 Badge -->
        <TextView
            android:id="@+id/tvStatusBadge"
            style="@style/Widget.QuickLaunch.Glass.StatusBadge.Success"
            android:layout_marginStart="14dp"
            android:layout_marginTop="4dp"
            android:text="成功"
            app:layout_constraintStart_toEndOf="@id/vStatusDot"
            app:layout_constraintTop_toBottomOf="@id/tvUrl" />

        <Button
            android:id="@+id/btnDelete"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="36dp"
            android:text="删除"
            android:textColor="@color/text_white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
