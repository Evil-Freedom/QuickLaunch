<?xml version="1.0" encoding="utf-8"?>
<!--
  暗黑极简胶囊风格（Dark Minimalist Capsule UI）
  - 扁平化重构：最大嵌套深度 ≤4 层（原 6 层）
  - 移除外层卡片包裹，每个主题项独立成行
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dark_root"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- 标题 -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:fontFamily="sans-serif-light"
            android:text="@string/theme_settings"
            android:textColor="@color/dark_text_primary"
            android:textSize="28sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-light"
            android:text="选择你喜欢的主题色与深浅模式"
            android:textColor="@color/dark_text_tertiary"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <!-- 主题色分组标题 -->
        <TextView
            android:id="@+id/tvColorTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-light"
            android:text="主题色"
            android:textAllCaps="true"
            android:textColor="@color/dark_text_secondary"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle" />

        <!-- 薄荷绿（深度 3：ConstraintLayout → View/TextView/RadioButton） -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardMint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_liquid_glass_rim"
            android:padding="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvColorTitle">

            <View
                android:id="@+id/swatchMint"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/color_swatch_mint"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="sans-serif-light"
                android:text="@string/theme_mint"
                android:textColor="@color/dark_text_primary"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/rbMint"
                app:layout_constraintStart_toEndOf="@id/swatchMint"
                app:layout_constraintTop_toTopOf="parent" />

            <RadioButton
                android:id="@+id/rbMint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/dark_accent_green"
                android:clickable="false"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 丁香紫 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardLavender"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_liquid_glass_rim"
            android:padding="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardMint">

            <View
                android:id="@+id/swatchLavender"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/color_swatch_lavender"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="sans-serif-light"
                android:text="@string/theme_lavender"
                android:textColor="@color/dark_text_primary"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/rbLavender"
                app:layout_constraintStart_toEndOf="@id/swatchLavender"
                app:layout_constraintTop_toTopOf="parent" />

            <RadioButton
                android:id="@+id/rbLavender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/dark_accent_green"
                android:clickable="false"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 经典绿 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardClassic"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_liquid_glass_rim"
            android:padding="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardLavender">

            <View
                android:id="@+id/swatchClassic"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/color_swatch_classic"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="sans-serif-light"
                android:text="@string/theme_classic"
                android:textColor="@color/dark_text_primary"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/rbClassic"
                app:layout_constraintStart_toEndOf="@id/swatchClassic"
                app:layout_constraintTop_toTopOf="parent" />

            <RadioButton
                android:id="@+id/rbClassic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/dark_accent_green"
                android:clickable="false"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 薰衣草紫 Pro -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardLavenderPro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_liquid_glass_rim"
            android:padding="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardClassic">

            <View
                android:id="@+id/swatchLavenderPro"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/color_swatch_lavender_pro"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="sans-serif-light"
                android:text="薰衣草紫 Pro"
                android:textColor="@color/dark_text_primary"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/rbLavenderPro"
                app:layout_constraintStart_toEndOf="@id/swatchLavenderPro"
                app:layout_constraintTop_toTopOf="parent" />

            <RadioButton
                android:id="@+id/rbLavenderPro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/accent_lavender"
                android:clickable="false"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 深浅模式分组标题 -->
        <TextView
            android:id="@+id/tvModeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-light"
            android:text="深浅模式"
            android:textAllCaps="true"
            android:textColor="@color/dark_text_secondary"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardClassic" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleThemeMode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:selectionRequired="true"
            app:singleSelection="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvModeTitle">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModeSystem"
                style="@style/Widget.QuickLaunch.Dark.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/theme_mode_system" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModeLight"
                style="@style/Widget.QuickLaunch.Dark.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/theme_mode_light" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModeDark"
                style="@style/Widget.QuickLaunch.Dark.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/theme_mode_dark" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
