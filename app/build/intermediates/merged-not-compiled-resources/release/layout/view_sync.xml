<?xml version="1.0" encoding="utf-8"?>
<!--
  Tab 2：同步源 — Glassmorphism UI 重构
  - 状态指示灯圆点（已同步绿色 / 未同步灰色）
  - 状态 Badge（成功 / 未同步）
  - 扁平化重构：最大嵌套深度 ≤4 层
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/syncScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="@dimen/dark_scroll_bottom_gap">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- 页面标题 -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-light"
            android:text="同步源"
            android:textColor="@color/text_white"
            android:textSize="28sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 防外屏息屏卡片 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutAntiSleep"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_liquid_glass_rim"
            android:padding="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle">

            <TextView
                android:id="@+id/tvAntiSleep"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:text="防外屏息屏"
                android:textColor="@color/text_white"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="@id/swAntiSleep"
                app:layout_constraintEnd_toStartOf="@id/swAntiSleep"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/swAntiSleep" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swAntiSleep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:thumbTint="@color/dark_switch_thumb"
                android:trackTint="@color/dark_switch_track"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ═══ 数据源状态可视化卡片（新增）═══ -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutSourceStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_liquid_glass_rim"
            android:padding="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutAntiSleep">

            <TextView
                android:id="@+id/tvSourceStatusTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:letterSpacing="0.05"
                android:text="数据源状态"
                android:textAllCaps="true"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- timor.tech 状态行 -->
            <LinearLayout
                android:id="@+id/rowTimor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvSourceStatusTitle">

                <View
                    android:id="@+id/dotTimor"
                    android:layout_width="@dimen/glass_status_dot_size"
                    android:layout_height="@dimen/glass_status_dot_size"
                    android:background="@drawable/status_dot_synced" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-light"
                    android:text="timor.tech"
                    android:textColor="@color/text_white"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/badgeTimor"
                    style="@style/Widget.QuickLaunch.Glass.StatusBadge.Success"
                    android:text="成功" />
            </LinearLayout>

            <!-- holiday-cn 状态行 -->
            <LinearLayout
                android:id="@+id/rowHolidayCn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rowTimor">

                <View
                    android:id="@+id/dotHolidayCn"
                    android:layout_width="@dimen/glass_status_dot_size"
                    android:layout_height="@dimen/glass_status_dot_size"
                    android:background="@drawable/status_dot_unsynced" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-light"
                    android:text="holiday-cn"
                    android:textColor="@color/text_white"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/badgeHolidayCn"
                    style="@style/Widget.QuickLaunch.Glass.StatusBadge.Pending"
                    android:text="未同步" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 节假日同步卡片 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutHolidayCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_liquid_glass_rim"
            android:padding="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutSourceStatus">

            <TextView
                android:id="@+id/tvHolidayTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:letterSpacing="0.05"
                android:text="法定节假日数据"
                android:textAllCaps="true"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- 数据源选择行 -->
            <TextView
                android:id="@+id/tvSourceLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-light"
                android:text="数据源"
                android:textColor="@color/text_white"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="@id/spinnerSource"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/spinnerSource" />

            <Spinner
                android:id="@+id/spinnerSource"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/text_white"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/tvSourceLabel"
                app:layout_constraintTop_toBottomOf="@id/tvHolidayTitle" />

            <!-- 同步按钮：46dp 纯白大胶囊 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSyncHolidays"
                style="@style/Widget.QuickLaunch.Dark.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="@dimen/glass_button_height"
                android:layout_marginTop="10dp"
                android:text="同步法定节假日"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/spinnerSource" />

            <!-- 管理按钮组 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnManageHolidays"
                style="@style/Widget.QuickLaunch.Dark.Button.Action"
                android:layout_width="0dp"
                android:layout_height="@dimen/glass_button_height"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:text="手动管理节假日"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnSyncHolidays" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnManageSources"
                style="@style/Widget.QuickLaunch.Dark.Button.Action"
                android:layout_width="0dp"
                android:layout_height="@dimen/glass_button_height"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:text="管理数据源"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnManageHolidays" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
