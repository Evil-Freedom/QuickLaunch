<?xml version="1.0" encoding="utf-8"?>
<!--
  底部渐变遮罩：120dp 高，从底部不透明渐变到透明。
  用于在悬浮药丸底栏后方提供暗色衬底，避免滚动内容文字与底栏重叠穿透。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="@color/bottom_gradient_solid"
        android:centerColor="#D90F0F0F"
        android:endColor="@color/bottom_gradient_transparent"
        android:type="linear" />
</shape>
